# Samba global configuration — managed by NASe.
# The [shares] section below is appended by modules/samba/setup.sh.
# Do not edit /etc/samba/smb.conf directly; edit config.yaml and re-run apply.sh.

[global]
   workgroup = __WORKGROUP__
   server string = NAS Server (%h)
   server role = standalone server

   # Security
   security = user
   map to guest = never
   smb encrypt = desired

   # Performance
   socket options = TCP_NODELAY IPTOS_LOWDELAY
   read raw = yes
   write raw = yes
   max xmit = 65535
   dead time = 15

   # Logging — cap at 10 MB
   log file = /var/log/samba/log.%m
   max log size = 10240
   logging = file

   # Share-connect auditing — lets the Monitoring tab attribute a drive
   # wake-up to a Samba client even when the connection was brief enough
   # to have already ended by the time spin_sample.sh takes its next
   # sample (smbstatus only shows what's connected *right now*). Logs one
   # syslog line per tree-connect (and disconnect), not per file operation,
   # so this doesn't turn into a firehose.
   full_audit:prefix = %u|%I|%S
   full_audit:success = connect disconnect
   full_audit:failure = connect
   full_audit:facility = LOCAL7
   full_audit:priority = NOTICE

   # macOS / iOS compatibility (SMB2/3 + Apple metadata)
   vfs objects = fruit streams_xattr full_audit
   fruit:metadata = stream
   fruit:model = MacSamba
   fruit:posix_rename = yes
   fruit:veto_appledouble = yes
   fruit:wipe_intentionally_left_blank_rfork = yes
   fruit:delete_empty_adfiles = yes

   # Do not share printers
   load printers = no
   printing = bsd
   printcap name = /dev/null
   disable spoolss = yes

# ── Shares (appended by setup.sh) ─────────────────────────────────────────────
