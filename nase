#!/usr/bin/env bash
# nase — NASe management CLI
# Usage: nase <command> [args]
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export REPO_ROOT

source "${REPO_ROOT}/lib/log.sh"
source "${REPO_ROOT}/lib/config.sh"
source "${REPO_ROOT}/lib/checks.sh"

# ── Colours for printf (actual escape bytes via $'...', not log.sh literals) ──
if [[ -t 1 ]]; then
    _C_RST=$'\e[0m'
    _C_BOLD=$'\e[1m'
    _C_GREEN=$'\e[0;32m'
    _C_RED=$'\e[0;31m'
    _C_YELLOW=$'\e[0;33m'
    _C_CYAN=$'\e[0;36m'
else
    _C_RST='' _C_BOLD='' _C_GREEN='' _C_RED='' _C_YELLOW='' _C_CYAN=''
fi

# ── Helpers ───────────────────────────────────────────────────────────────────

# Active state of a systemd unit, e.g. "active" or "inactive"
_unit_state() { systemctl is-active "$1" 2>/dev/null || true; }

# Enabled state of a systemd unit, e.g. "enabled" or "disabled"
_unit_enabled() { systemctl is-enabled "$1" 2>/dev/null || true; }

# Format a timestamp returned by systemctl show --value.
# systemctl returns a human-readable string like "Mon 2026-04-27 06:00:00 UTC",
# not a raw microsecond value — pass it straight to date -d for reformatting.
_utime() {
    local val="$1"
    [[ -z "$val" || "$val" == "0" || "$val" == "n/a" ]] && echo "—" && return
    date -d "$val" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo "—"
}

# Human-readable "time ago" from a Unix timestamp.
_ago() {
    local ts="$1"
    [[ -z "$ts" || "$ts" == "0" ]] && echo "—" && return
    local diff=$(( $(date +%s) - ts ))
    if   [[ $diff -lt 60 ]];    then echo "${diff}s ago"
    elif [[ $diff -lt 3600 ]];  then echo "$(( diff / 60 ))min ago"
    elif [[ $diff -lt 86400 ]]; then echo "$(( diff / 3600 ))h ago"
    else echo "$(( diff / 86400 ))d ago"
    fi
}

# Coloured state badge for printf (does not add newline).
_state_badge() {
    local state="$1"
    case "$state" in
        active)   printf "${_C_GREEN}%-8s${_C_RST}" "active"   ;;
        inactive) printf "${_C_YELLOW}%-8s${_C_RST}" "stopped"  ;;
        failed)   printf "${_C_RED}%-8s${_C_RST}"   "failed"   ;;
        *)        printf "${_C_YELLOW}%-8s${_C_RST}" "$state"   ;;
    esac
}

# ── status ────────────────────────────────────────────────────────────────────

cmd_status() {
    printf "\n${_C_BOLD}NASe — System Status${_C_RST}\n\n"

    # ── Services ──────────────────────────────────────────────────────────────
    printf "${_C_BOLD}Services${_C_RST}\n"

    # SMART monitor timer
    local monitor_state next_val next_str
    monitor_state=$(_unit_state nase-monitor.timer)
    next_val=$(systemctl show nase-monitor.timer \
        --property=NextElapseUSecRealtime --value 2>/dev/null || echo "")
    next_str=$(_utime "$next_val")
    printf "  %-22s " "nase-monitor"
    _state_badge "$monitor_state"
    printf "  next %s\n" "$next_str"

    # Filebrowser
    if config_bool '.services.filebrowser.enabled' 2>/dev/null; then
        local fb_state fb_port
        fb_state=$(_unit_state filebrowser.service)
        fb_port=$(config_get '.services.filebrowser.port')
        printf "  %-22s " "filebrowser"
        _state_badge "$fb_state"
        [[ "$fb_state" == "active" ]] && printf "  http://localhost:%s" "$fb_port"
        echo ""
    fi

    # Tailscale
    if config_bool '.tailscale.enabled' 2>/dev/null; then
        local ts_state
        if tailscale status &>/dev/null; then
            ts_state="active"
        else
            ts_state="not connected"
        fi
        printf "  %-22s " "tailscale"
        _state_badge "$ts_state"
        echo ""
    fi

    printf "\n"

    # ── Config archive timer ──────────────────────────────────────────────────
    printf "${_C_BOLD}Config Archive${_C_RST}\n"
    printf "  %-22s %-10s %-22s %s\n" "JOB" "STATUS" "NEXT TRIGGER" "LAST RUN"
    printf "  %s\n" "────────────────────────────────────────────────────────────────────────────"

    local ca_state ca_next_val ca_next_str ca_stamp_file ca_last_str
    ca_state=$(_unit_state nase-config-archive.timer)
    ca_next_val=$(systemctl show nase-config-archive.timer \
        --property=NextElapseUSecRealtime --value 2>/dev/null || echo "")
    ca_next_str=$(_utime "$ca_next_val")
    [[ "$ca_state" != "active" ]] && ca_next_str="—"
    ca_stamp_file="/var/lib/nase/config-archive.stamp"
    if [[ -f "$ca_stamp_file" ]]; then
        local ca_ts
        ca_ts=$(stat -c %Y "$ca_stamp_file")
        ca_last_str="$(date -d "@${ca_ts}" '+%Y-%m-%d %H:%M:%S') ($(_ago "$ca_ts"))"
    else
        ca_last_str="never"
    fi
    printf "  %-22s " "config-archive"
    _state_badge "$ca_state"
    printf "  %-22s %s\n" "$ca_next_str" "$ca_last_str"

    printf "\n"

    # ── Sync timers ───────────────────────────────────────────────────────────
    printf "${_C_BOLD}Sync Timers${_C_RST}\n"
    printf "  %-22s %-10s %-22s %s\n" "JOB" "STATUS" "NEXT TRIGGER" "LAST SYNC"
    printf "  %s\n" "────────────────────────────────────────────────────────────────────────────"

    local n
    n=$(config_len '.sync_jobs')
    for i in $(seq 0 $((n - 1))); do
        local job_name timer_unit state next_val next_str stamp_file last_str
        job_name=$(config_idx '.sync_jobs' "$i" '.name')
        timer_unit="nase-sync-${job_name}.timer"

        state=$(_unit_state "$timer_unit")
        next_val=$(systemctl show "$timer_unit" \
            --property=NextElapseUSecRealtime --value 2>/dev/null || echo "")
        next_str=$(_utime "$next_val")
        [[ "$state" != "active" ]] && next_str="—"

        stamp_file="/var/lib/nase/sync-${job_name}.stamp"
        if [[ -f "$stamp_file" ]]; then
            local stamp_ts
            stamp_ts=$(stat -c %Y "$stamp_file")
            last_str="$(date -d "@${stamp_ts}" '+%Y-%m-%d %H:%M:%S') ($(_ago "$stamp_ts"))"
        else
            last_str="never"
        fi

        printf "  %-22s " "$job_name"
        _state_badge "$state"
        printf "  %-22s %s\n" "$next_str" "$last_str"
    done

    printf "\n"

    # ── Drives ────────────────────────────────────────────────────────────────
    printf "${_C_BOLD}Drives${_C_RST}\n"
    _drives_table "  "
    printf "\n"
}

# ── pause / resume ────────────────────────────────────────────────────────────

cmd_pause() {
    local n count=0
    n=$(config_len '.sync_jobs')
    for i in $(seq 0 $((n - 1))); do
        local job timer
        job=$(config_idx '.sync_jobs' "$i" '.name')
        timer="nase-sync-${job}.timer"
        if systemctl is-active --quiet "$timer" 2>/dev/null; then
            systemctl stop "$timer"
            log_ok "Stopped ${timer}"
            (( count++ )) || true
        else
            log_info "${timer} is already stopped"
        fi
    done
    if [[ $count -gt 0 ]]; then
        log_ok "Sync timers paused. Run 'sudo nase resume' to restart."
    else
        log_info "No timers were running."
    fi
}

cmd_resume() {
    local n
    n=$(config_len '.sync_jobs')
    for i in $(seq 0 $((n - 1))); do
        local job timer
        job=$(config_idx '.sync_jobs' "$i" '.name')
        timer="nase-sync-${job}.timer"
        if systemctl is-enabled --quiet "$timer" 2>/dev/null; then
            systemctl start "$timer"
            log_ok "Started ${timer}"
        else
            log_warn "${timer} is not enabled — run 'sudo apply.sh' first"
        fi
    done
    log_ok "Sync timers resumed."
}

# ── drives ────────────────────────────────────────────────────────────────────

# "active 1737463000 confirmed" -> "spinning (2h)"; "standby ... estimated" -> "standby (~2h)"
_spin_label() {
    local name="$1"
    local out state since confidence now diff dur prefix=""
    out=$("${REPO_ROOT}/modules/drives/spin_status.sh" "$name" 2>/dev/null || true)
    read -r state since confidence <<<"$out"
    [[ "$state" == "active" || "$state" == "standby" ]] || { echo "—"; return; }

    now=$(date +%s)
    diff=$(( now - since ))
    if   [[ $diff -lt 60 ]];    then dur="${diff}s"
    elif [[ $diff -lt 3600 ]];  then dur="$(( diff / 60 ))min"
    elif [[ $diff -lt 86400 ]]; then dur="$(( diff / 3600 ))h"
    else                             dur="$(( diff / 86400 ))d"
    fi
    [[ "$confidence" == "estimated" ]] && prefix="~"

    if [[ "$state" == "active" ]]; then
        echo "${_C_GREEN}spinning${_C_RST} (${prefix}${dur})"
    else
        echo "${_C_YELLOW}standby${_C_RST} (${prefix}${dur})"
    fi
}

# Shared table renderer; pass an indent string (e.g. "  ") or empty.
_drives_table() {
    local indent="${1:-}"
    local n
    n=$(config_len '.drives')

    printf "%s%-12s %-20s %-10s %-5s %-20s %s\n" \
        "$indent" "NAME" "MOUNTPOINT" "STATUS" "MODE" "USAGE" "SPIN"
    printf "%s%s\n" "$indent" \
        "────────────────────────────────────────────────────────────────────────────────"

    for i in $(seq 0 $((n - 1))); do
        local name mp active
        name=$(config_idx   '.drives' "$i" '.name')
        mp=$(config_idx     '.drives' "$i" '.mountpoint')
        active=$(config_idx '.drives' "$i" '.active')

        if [[ "$active" == "false" ]]; then
            printf "%s%-12s %-20s ${_C_YELLOW}%-10s${_C_RST}\n" \
                "$indent" "$name" "$mp" "inactive"
            continue
        fi

        local spin
        spin=$(_spin_label "$name")

        if ! findmnt --target "$mp" --noheadings &>/dev/null; then
            printf "%s%-12s %-20s ${_C_RED}%-10s${_C_RST} %-5s %-20s %s\n" \
                "$indent" "$name" "$mp" "not mounted" "" "" "$spin"
            continue
        fi

        local opts mode usage
        opts=$(findmnt --target "$mp" \
            --output OPTIONS --noheadings --first-only 2>/dev/null || echo "")
        if echo "$opts" | grep -qw ro; then mode="ro"; else mode="rw"; fi
        usage=$(df -h "$mp" 2>/dev/null \
            | awk 'NR==2 {print $3 " / " $2 " (" $5 ")"}' || echo "—")

        printf "%s%-12s %-20s ${_C_GREEN}%-10s${_C_RST} %-5s %-20s %s\n" \
            "$indent" "$name" "$mp" "mounted" "$mode" "$usage" "$spin"
    done
}

cmd_drives() {
    printf "\n${_C_BOLD}Drives${_C_RST}\n"
    _drives_table
    printf "\n"
}

# ── remount ───────────────────────────────────────────────────────────────────

cmd_remount() {
    local mode="${1:-}"
    local target_name="${2:-}"  # optional: specific drive name
    [[ "$mode" == "rw" || "$mode" == "ro" ]] || {
        log_error "Usage: nase remount <rw|ro> [<drive-name>]"
        exit 1
    }

    # Collect active backup drives (all, or the one named by $target_name).
    local -a backup_mps=()
    local -a backup_names=()
    local n i name role active mp
    n=$(config_len '.drives')
    for i in $(seq 0 $((n - 1))); do
        role=$(config_idx   '.drives' "$i" '.role')
        active=$(config_idx '.drives' "$i" '.active')
        name=$(config_idx   '.drives' "$i" '.name')
        mp=$(config_idx     '.drives' "$i" '.mountpoint')
        [[ "$role" == "backup" && "$active" != "false" ]] || continue
        [[ -z "$target_name" || "$name" == "$target_name" ]] || continue
        backup_mps+=("$mp")
        backup_names+=("$name")
    done

    if [[ ${#backup_mps[@]} -eq 0 ]]; then
        if [[ -n "$target_name" ]]; then
            die "No active backup drive named '${target_name}' found in config."
        else
            die "No active drives with role=backup found in config."
        fi
    fi

    local remounted=0
    for i in "${!backup_mps[@]}"; do
        mp="${backup_mps[$i]}"
        name="${backup_names[$i]}"

        if ! findmnt --target "$mp" --noheadings &>/dev/null; then
            log_warn "Drive '${name}' is not mounted at ${mp} — skipping."
            continue
        fi

        local current_opts current_mode
        current_opts=$(findmnt --target "$mp" \
            --output OPTIONS --noheadings --first-only 2>/dev/null || echo "")
        if echo "$current_opts" | grep -qw ro; then current_mode="ro"
        else current_mode="rw"
        fi

        if [[ "$current_mode" == "$mode" ]]; then
            log_info "Drive '${name}' (${mp}) is already mounted ${mode}."
            continue
        fi

        log_info "Remounting ${mp} ${mode}..."
        mount -o "remount,${mode}" "$mp"
        log_ok "Drive '${name}' (${mp}) remounted ${mode}."
        (( remounted++ )) || true
    done

    if [[ "$mode" == "rw" && $remounted -gt 0 ]]; then
        log_warn "Remember to remount read-only when done:  sudo nase remount ro"
    fi
}

# ── integrity ─────────────────────────────────────────────────────────────────

# _integrity_mountpoint_for_name NAME
# Resolve an active configured drive name to its mountpoint (empty if not found).
_integrity_mountpoint_for_name() {
    local target="$1" n i name active
    n=$(config_len '.drives')
    for i in $(seq 0 $((n - 1))); do
        name=$(config_idx '.drives' "$i" '.name')
        active=$(config_idx '.drives' "$i" '.active')
        [[ "$name" == "$target" && "$active" != "false" ]] || continue
        config_idx '.drives' "$i" '.mountpoint'
        return 0
    done
}

cmd_integrity() {
    local sub="${1:-}"
    [[ $# -gt 0 ]] && shift || true
    source "${REPO_ROOT}/modules/integrity/common.sh"

    case "$sub" in
        status)
            local target="${1:-}"
            local n i name active mp db
            n=$(config_len '.drives')
            for i in $(seq 0 $((n - 1))); do
                name=$(config_idx '.drives' "$i" '.name')
                active=$(config_idx '.drives' "$i" '.active')
                [[ "$active" != "false" ]] || continue
                [[ -z "$target" || "$name" == "$target" ]] || continue
                mp=$(config_idx '.drives' "$i" '.mountpoint')
                db=$(integrity_db_path "$mp")
                printf "\n${_C_BOLD}%s${_C_RST}  (%s)\n" "$name" "$mp"
                if [[ ! -f "$db" ]]; then
                    echo "  no manifest yet — run 'sudo nase apply integrity'"
                    continue
                fi
                local total ok flagged complete
                total=$(integrity_row_count "$db")
                ok=$(integrity_row_count "$db" "ok")
                flagged=$(integrity_row_count "$db" "flagged")
                complete=$(integrity_meta_get "$db" "discovery_complete")
                printf "  %-11s %s\n" "files:" "$total"
                printf "  %-11s %s\n" "ok:" "$ok"
                printf "  %-11s ${_C_YELLOW}%s${_C_RST}\n" "flagged:" "$flagged"
                printf "  %-11s %s\n" "discovery:" "$([[ "$complete" == "true" ]] && echo "complete" || echo "in progress")"
                if [[ "$flagged" -gt 0 ]]; then
                    echo "  flagged paths (ack with: sudo nase integrity ack ${name} <path>):"
                    sqlite3 "$db" "SELECT path FROM files WHERE status='flagged' ORDER BY path LIMIT 50;" \
                        | sed 's/^/    /'
                fi
            done
            echo ""
            ;;
        ack)
            local target="${1:-}" path="${2:-}" mp db esc_path found now
            [[ -n "$target" && -n "$path" ]] || { log_error "Usage: nase integrity ack <drive> <path>"; exit 1; }
            mp=$(_integrity_mountpoint_for_name "$target")
            [[ -n "$mp" ]] || die "No active drive named '${target}' found in config."
            db=$(integrity_db_path "$mp")
            [[ -f "$db" ]] || die "No manifest for '${target}' at ${db}."
            esc_path=$(_integrity_escape "$path")
            found=$(sqlite3 "$db" "SELECT COUNT(*) FROM files WHERE path = '${esc_path}' AND status='flagged';")
            [[ "$found" -gt 0 ]] || die "No flagged row for '${path}' on drive '${target}'."
            now=$(date +%s)
            sqlite3 -bail -cmd ".timeout 30000" "$db" <<SQL
BEGIN;
UPDATE files SET status='ok', last_checked=${now} WHERE path = '${esc_path}';
INSERT INTO events (ts, path, event_type, detail) VALUES (${now}, '${esc_path}', 'ack', 'acknowledged via nase CLI');
COMMIT;
SQL
            # Refresh the dashboard's SD-card cache immediately, rather than
            # leaving it showing the just-acked file as flagged until the
            # next nightly integrity pass — see common.sh.
            integrity_write_status_cache "$mp" "$db" || true
            log_ok "Acknowledged '${path}' on drive '${target}' — marked ok."
            ;;
        bootstrap)
            local target="${1:-}" limit="${2:-}" mp
            [[ -n "$target" ]] || { log_error "Usage: nase integrity bootstrap <drive> [limit]"; exit 1; }
            mp=$(_integrity_mountpoint_for_name "$target")
            [[ -n "$mp" ]] || die "No active drive named '${target}' found in config."
            "${REPO_ROOT}/modules/integrity/bootstrap.sh" "$mp" "$limit"
            ;;
        *)
            log_error "Usage: nase integrity <status|ack|bootstrap> ..."
            exit 1
            ;;
    esac
}

# ── sync ──────────────────────────────────────────────────────────────────────

cmd_sync() {
    exec "${REPO_ROOT}/sync.sh" "$@"
}

# ── logs ──────────────────────────────────────────────────────────────────────

cmd_logs() {
    local follow=false target=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -f|--follow) follow=true ;;
            *)           target="$1" ;;
        esac
        shift
    done

    local log_file
    if [[ -z "$target" ]]; then
        log_file="${NAS_LOG:-/var/log/nase/nase.log}"
    else
        log_file="/var/log/nase-sync-${target}.log"
    fi

    [[ -f "$log_file" ]] || die "Log not found: ${log_file}"

    if [[ "$follow" == "true" ]]; then
        echo "Following ${log_file}  (Ctrl-C to stop)"
        tail -f "$log_file"
    else
        tail -n 60 "$log_file"
    fi
}

# ── web-restart ───────────────────────────────────────────────────────────────

cmd_web_restart() {
    systemctl restart nase-web.service
    log_ok "nase-web.service restarted."
}

# ── apply ─────────────────────────────────────────────────────────────────────

_apply_preflight() {
    preflight_checks
    set -a
    # shellcheck disable=SC1091
    source "${REPO_ROOT}/.env"
    set +a
    "${REPO_ROOT}/tests/validate-config.sh"
    check_drive_uuids
}

_run_module() {
    local module="$1"
    log_section "$module"
    bash "${REPO_ROOT}/modules/${module}/setup.sh"
}

cmd_apply() {
    local section="${1:-}"
    case "$section" in
        ""|all)
            exec "${REPO_ROOT}/apply.sh"
            ;;
        nas|general)
            _apply_preflight
            log_section "nas"
            local hostname
            hostname=$(config_get '.nas.hostname')
            if [[ -n "$hostname" ]]; then
                log_info "Setting hostname to '${hostname}'..."
                hostnamectl set-hostname "$hostname"
                log_ok "Hostname set to '${hostname}'."
            fi
            ;;
        drives)
            _apply_preflight
            _run_module drives
            _run_module integrity
            # Cascade: all modules whose systemd units reference drive mountpoints
            # in After= must be regenerated whenever drives change.
            _run_module config-archive
            _run_module samba
            _run_module sync
            config_bool '.services.filebrowser.enabled' 2>/dev/null && _run_module filebrowser
            ;;
        samba)
            _apply_preflight
            _run_module samba
            ;;
        sync|sync_jobs)
            _apply_preflight
            _run_module sync
            ;;
        services)
            _apply_preflight
            local need_drives=false
            config_bool '.services.filebrowser.enabled' 2>/dev/null && need_drives=true
            if [[ "$need_drives" == "true" ]]; then
                log_info "Prerequisite: drives (required by filebrowser)"
                _run_module drives
            fi
            config_bool '.services.web.enabled' 2>/dev/null && _run_module web
            config_bool '.services.filebrowser.enabled' 2>/dev/null && _run_module filebrowser
            ;;
        tailscale)
            _apply_preflight
            if config_bool '.tailscale.enabled' 2>/dev/null; then
                _run_module tailscale
            else
                log_info "Tailscale is disabled in config — nothing to apply."
            fi
            ;;
        notifications)
            _apply_preflight
            log_section "notifications"
            log_ok "Notifications config is read at runtime by sync jobs — no service to restart."
            ;;
        config-archive|config_archive)
            _apply_preflight
            _run_module config-archive
            ;;
        integrity)
            _apply_preflight
            _run_module integrity
            ;;
        watch|file_watch)
            _apply_preflight
            _run_module watch
            ;;
        status-report|status_report)
            _apply_preflight
            _run_module status-report
            ;;
        *)
            log_error "Unknown section: '${section}'"
            log_info "Valid sections: nas, drives, samba, sync, config-archive, integrity, services, tailscale, notifications, watch, status-report"
            exit 1
            ;;
    esac
}

# ── report ────────────────────────────────────────────────────────────────────

cmd_report() {
    if [[ -f "${REPO_ROOT}/.env" ]]; then
        set -a; source "${REPO_ROOT}/.env"; set +a
    fi
    log_info "Generating and sending status report now..."
    exec "${REPO_ROOT}/modules/status-report/report.sh"
}

# ── notify-test ───────────────────────────────────────────────────────────────

cmd_notify_test() {
    # Load secrets so SMTP / webhook settings are available
    if [[ -f "${REPO_ROOT}/.env" ]]; then
        set -a; source "${REPO_ROOT}/.env"; set +a
    fi
    log_info "Sending test notification..."
    printf '%s' "This is a test message sent via 'nase notify-test' on $(date '+%Y-%m-%d %H:%M:%S')." \
        | "${REPO_ROOT}/modules/sync/notify.sh" "NASe test notification from $(hostname)"
    log_ok "Done."
}

# ── usage ─────────────────────────────────────────────────────────────────────

usage() {
    cat <<EOF

${_C_BOLD}Usage:${_C_RST} nase <command> [options]

${_C_BOLD}Commands:${_C_RST}
  status                  Show overall system status
  pause                   Stop all sync timers (persists until resume or reboot)
  resume                  Restart all stopped sync timers
  drives                  Show drive mount status and disk usage
  sync [--all | <job>]    Run sync jobs interactively or by name
  remount <rw|ro> [name]  Remount backup drive(s) rw or ro
                            (omit name to remount all backup drives)
  integrity status [name] Show checksum manifest status (flagged files, discovery progress)
  integrity ack <name> <path>
                          Clear a flagged file after manual review
  integrity bootstrap <name> [limit]
                          Run checksum discovery at full speed. With no [limit], runs
                          as a sequence of 200000-file passes until discovery
                          completes. With [limit], stop after that many new files —
                          safe to re-run (e.g. daily) to spread a big backlog over
                          several days.
  logs [-f] [<job>]       Show recent log entries; -f to follow
                            (no job = central log, job name = that job's rsync log)
  web-restart             Restart the web dashboard service
  notify-test             Send a test notification via the configured method
  report                  Send a status report immediately (for testing)

  apply [<section>]       Apply config to a specific module (or all if omitted)
    nas                     Set hostname
    drives                  Mount units and spindown rules
    samba                   Samba shares and users     [prereq: drives]
    sync                    Sync job timers            [prereq: drives]
    config-archive          Config archive timer
    integrity               Checksum manifest (.nase/ dirs + schema)   [prereq: drives]
    services                Web dashboard + filebrowser [prereq: drives]
    tailscale               Tailscale VPN
    notifications           Validate only (config read at runtime)
    status-report           Status report timer

${_C_BOLD}Examples:${_C_RST}
  nase status
  sudo nase pause
  sudo nase sync music-backup
  nase logs
  nase logs -f music-backup
  sudo nase apply
  sudo nase apply samba
  sudo nase apply services

EOF
}

# ── Dispatch ──────────────────────────────────────────────────────────────────

CMD="${1:-}"
[[ $# -gt 0 ]] && shift || true

case "$CMD" in
    status)      cmd_status ;;
    pause)       check_root; cmd_pause ;;
    resume)      check_root; cmd_resume ;;
    drives)      cmd_drives ;;
    sync)        check_root; cmd_sync "$@" ;;
    remount)     check_root; cmd_remount "$@" ;;
    integrity)   check_root; cmd_integrity "$@" ;;
    logs)        cmd_logs "$@" ;;
    web-restart) check_root; cmd_web_restart ;;
    notify-test) check_root; cmd_notify_test ;;
    report)      check_root; cmd_report ;;
    apply)       check_root; cmd_apply "$@" ;;
    help|--help|-h|"") usage ;;
    *) log_error "Unknown command: '${CMD}'"; usage; exit 1 ;;
esac
